        DOCKER["Docker Compose<br/>healthcheck · read-only mount"]:::runtime
        API["FastAPI inference<br/>POST /predict"]:::runtime

        ARTIFACTS --> DOCKER --> API
    end

    subgraph COPILOT["AGENTIC INCIDENT RESPONSE"]
        direction LR
        KNOWLEDGE["Trusted project knowledge<br/>docs · configs · reports · CI"]:::data
        RAG["Local RAG<br/>line chunks · TF-IDF retrieval"]:::agent
        GRAPH["LangGraph copilot<br/>quality-gated routing"]:::agent
        GUIDANCE["Cited incident guidance"]:::output
        HUMAN["Human approval boundary<br/>privileged actions stay manual"]:::human

        KNOWLEDGE --> RAG --> GRAPH --> GUIDANCE --> HUMAN
    end

    CI -. "audits & validates" .-> MODEL
    MODEL -->|"approved artifacts"| SERVING
    MODEL -->|"quality gate result"| COPILOT
    SERVING -->|"classification"| COPILOT

